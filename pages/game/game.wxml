<view class="page">
  <view class="topline">
    <view>
      <view class="game-title">本局进行中</view>
      <view class="small-copy">{{seats.length}} 位玩家 · 第 {{dayNumber}} 天 · 身份仅在验证后查看</view>
    </view>
    <button class="text-button" size="mini" bindtap="endGame">结束</button>
  </view>

  <view class="timer-panel">
    <view class="current-label">当前发言</view>
    <picker mode="selector" range="{{seatOptions}}" bindchange="chooseSpeaker">
      <view class="speaker">{{currentSpeakerLabel}}　⌄</view>
    </picker>
    <view class="order-hint">{{speechOrderHint}}</view>
    <view class="order-text">顺序：{{speechOrderText}}</view>
    <view class="clock">{{remainingText}}</view>
    <view class="timer-state">{{timerRunning ? '计时中' : (timerExpired ? '时间到' : '已暂停')}}</view>
    <view class="timer-buttons">
      <button class="timer-secondary" bindtap="previousSpeaker">上一位</button>
      <button wx:if="{{!timerRunning}}" class="timer-primary" bindtap="startTimer">开始</button>
      <button wx:else class="timer-primary" bindtap="pauseTimer">暂停</button>
      <button class="timer-secondary" bindtap="nextSpeaker">下一位</button>
    </view>
    <button class="timer-reset" bindtap="resetTimer">重置计时</button>
  </view>

  <view class="record-panel">
    <view class="panel-title">发言顺序与警长</view>
    <view class="record-row"><text>当前天数</text><input class="small-input" type="number" value="{{dayNumber}}" bindinput="dayInput" /></view>
    <view class="record-row"><text>警长</text><picker mode="selector" range="{{sheriffOptions}}" bindchange="sheriffChange"><view class="picker-value">{{sheriffSeat ? sheriffSeat + ' 号' : '无警长'}}　⌄</view></picker></view>
    <view class="record-actions"><button size="mini" bindtap="clearSheriff">取消警长</button><button size="mini" bindtap="randomizeFirstDay">首日重新随机</button><button size="mini" bindtap="startNextDay">进入下一天</button></view>
    <view class="hint">有警长时由警长决定顺序；无警长时按死亡玩家左右或随机规则生成，主持人仍可手动调整。</view>
  </view>

  <view class="record-panel">
    <view class="panel-title">夜间信息</view>
    <view class="record-row"><text>记录</text><picker mode="selector" range="{{nightRecords}}" range-key="night" bindchange="chooseNightRecord"><view class="picker-value">第 {{nightRecord.night}} 夜　⌄</view></picker></view>
    <view class="record-row"><text>狼人袭击</text><input class="small-input" type="number" placeholder="座位号" value="{{nightRecord.attackedSeat}}" data-field="attackedSeat" bindinput="updateNightField" /></view>
    <view class="record-row"><text>守卫保护</text><input class="small-input" type="number" placeholder="座位号" value="{{nightRecord.guardSeat}}" data-field="guardSeat" bindinput="updateNightField" /></view>
    <view class="record-row"><text>女巫解药</text><switch checked="{{nightRecord.witchSave}}" bindchange="toggleNightSave" /></view>
    <view class="record-row"><text>女巫毒药</text><input class="small-input" type="number" placeholder="座位号（无则留空）" value="{{nightRecord.poisonSeat}}" data-field="poisonSeat" bindinput="updateNightField" /></view>
    <view class="record-row"><text>预言家查验</text><input class="small-input" type="number" placeholder="座位号" value="{{nightRecord.seerSeat}}" data-field="seerSeat" bindinput="updateNightField" /></view>
    <view class="record-row"><text>查验结果</text><input class="text-input" placeholder="好人 / 狼人" value="{{nightRecord.seerResult}}" data-field="seerResult" bindinput="updateNightField" /></view>
    <view class="record-row"><text>最终死亡</text><input class="text-input" placeholder="座位号，可填多个如 2,5" value="{{nightRecord.deathSeats}}" data-field="deathSeats" bindinput="updateNightField" /></view>
    <view class="record-actions"><button size="mini" bindtap="saveNightRecord">保存本夜</button><button size="mini" bindtap="newNightRecord">新增一夜</button></view>
  </view>

  <view class="record-panel">
    <view class="panel-title">投票信息</view>
    <view class="record-row"><text>记录</text><picker mode="selector" range="{{voteRecords}}" range-key="round" bindchange="chooseVoteRecord"><view class="picker-value">第 {{voteRecord.round}} 轮　⌄</view></picker></view>
    <view class="record-row"><text>被放逐</text><picker mode="selector" range="{{seatOptions}}" bindchange="chooseVoteEliminated"><view class="picker-value">{{voteRecord.eliminatedSeat ? voteRecord.eliminatedSeat + ' 号' : '未选择'}}　⌄</view></picker></view>
    <view class="record-row stacked"><text>逐人投票</text><input class="text-input" placeholder="例如：1→3，2→3，3→4" value="{{voteRecord.votes}}" data-field="votes" bindinput="updateVoteField" /></view>
    <view class="record-actions"><button size="mini" bindtap="saveVoteRecord">保存本轮</button><button size="mini" bindtap="newVoteRecord">新增一轮</button></view>
  </view>

  <view class="seat-heading">身份牌</view>
  <view class="privacy-hint">{{viewMode ? '身份查看模式已开启；离开前请退出。' : '先验证主持人口令，再选择座位查看身份。'}}</view>
  <view class="seat-grid">
    <button wx:for="{{seats}}" wx:key="seat" class="seat-tile {{item.viewed ? 'seat-viewed' : ''}} {{item.dead ? 'seat-dead' : ''}}" data-index="{{index}}" bindtap="openCard">
      <view class="tile-number">{{item.seat}} 号</view>
      <view class="tile-name">{{item.name || '玩家' + item.seat}}</view>
      <view class="tile-status">{{item.dead ? '已死亡' : (item.viewed ? '已查看' : '未查看')}}</view>
    </button>
  </view>

  <view wx:if="{{!viewMode}}" class="unlock-panel">
    <view class="unlock-title">主持人口令</view>
    <input class="code-input" type="number" password="true" maxlength="4" placeholder="输入 4 位数字口令" value="{{codeInput}}" bindinput="codeInput" />
    <button class="unlock-button" bindtap="enterViewMode">验证并查看</button>
  </view>
  <button wx:else class="exit-button" bindtap="exitViewMode">退出身份查看模式</button>
  <view class="game-actions"><button class="secondary-action" bindtap="reshuffle">重新洗牌</button></view>

  <view wx:if="{{activeCard}}" class="overlay" catchtap="closeCard">
    <view class="identity-modal" catchtap="keepModalOpen">
      <view class="modal-seat">{{activeCard.seat}} 号玩家</view>
      <view class="modal-name">{{activeCard.name || '未填写昵称'}}</view>
      <view class="identity-role">{{activeCard.role}}</view>
      <button class="unlock-button" bindtap="closeCard">确认并隐藏</button>
    </view>
  </view>
</view>